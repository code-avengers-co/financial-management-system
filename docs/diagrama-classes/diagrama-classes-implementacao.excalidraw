    {
      "id": "te81",
      "type": "text",
      "x": -316,
      "y": 1174,
      "width": 645.84,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1f2933",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
